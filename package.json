{
  "name": "sound-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:spirit": "esbuild ./scripts/verify-spirit-identity.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-spirit-identity.mjs && node node_modules/.tmp/verify-spirit-identity.mjs",
    "test:personality": "esbuild ./scripts/verify-spirit-personality.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-spirit-personality.mjs && node node_modules/.tmp/verify-spirit-personality.mjs",
    "test:home-audio": "esbuild ./scripts/verify-home-audio-wave.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-home-audio-wave.mjs && node node_modules/.tmp/verify-home-audio-wave.mjs",
    "test:gesture": "esbuild ./scripts/verify-gesture-foundation.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-gesture-foundation.mjs && node node_modules/.tmp/verify-gesture-foundation.mjs",
    "test:gesture-interactions": "esbuild ./scripts/verify-gesture-interactions.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-gesture-interactions.mjs && node node_modules/.tmp/verify-gesture-interactions.mjs",
    "test:gesture-polish": "esbuild ./scripts/verify-gesture-polish.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-gesture-polish.mjs && node node_modules/.tmp/verify-gesture-polish.mjs",
    "test:gesture-skeleton": "esbuild ./scripts/verify-gesture-skeleton.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-gesture-skeleton.mjs && node node_modules/.tmp/verify-gesture-skeleton.mjs",
    "test:birth": "esbuild ./scripts/verify-spirit-birth.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-spirit-birth.mjs && node node_modules/.tmp/verify-spirit-birth.mjs",
    "test:rhythm": "esbuild ./scripts/verify-audio-locked-heart.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-audio-locked-heart.mjs && node node_modules/.tmp/verify-audio-locked-heart.mjs",
    "test:beat-map": "esbuild ./scripts/verify-offline-beat-map.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-offline-beat-map.mjs && node node_modules/.tmp/verify-offline-beat-map.mjs",
    "test:heart-clock": "esbuild ./scripts/verify-beat-map-heart.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-beat-map-heart.mjs && node node_modules/.tmp/verify-beat-map-heart.mjs",
    "test:cinematic": "esbuild ./scripts/verify-cinematic-birth.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-cinematic-birth.mjs && node node_modules/.tmp/verify-cinematic-birth.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@vitejs/plugin-react": "^5.0.3",
    "vite": "^7.1.7",
    "typescript": "^5.9.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "lucide-react": "^0.544.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0"
  }
}
